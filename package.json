{
  "name": "jetbrains-search-provider",
  "version": "1.0.0-SNAPSHOT",
  "description": "Provide search results from JetBrains IDEs recent projects to GNOME Shell search",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emouty/jetbrains-search-provider.git"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/emouty/jetbrains-search-provider/issues"
  },
  "homepage": "https://github.com/emouty/jetbrains-search-provider#readme",
  "sideEffects": false,
  "config": {
    "domain": "emouty.github.com"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .  -c eslint.config.js",
    "lint:fix": "eslint --fix . -c eslint.config.js",
    "clean": "rm -rf dist && rm -f ${npm_package_name}.zip",
    "pack": "npm run clean && npm run build && cp metadata.json dist && cp -r schemas dist && glib-compile-schemas ./dist/schemas && cd dist && zip ../${npm_package_name}.zip -9r .",
    "install-extension": "gnome-extensions install ${npm_package_name}.zip --force",
    "setup": "npm run pack && npm run install-extension",
    "debug": "dbus-run-session -- gnome-shell --devkit --wayland",
    "prepare": "simple-git-hooks",
    "test": "node --loader ./tests/mocks/loader.js --loader tsm node_modules/.bin/uvu ./tests \\.spec\\.js$"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "simple-git-hooks": {
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "9.2.0",
    "@girs/gjs": "4.0.0-beta.38",
    "@girs/gnome-shell": "49.1.0",
    "@types/node": "20.14.2",
    "bumpp": "9.4.1",
    "esbuild": "0.25.0",
    "eslint": "8.57.0",
    "globals": "15.2.0",
    "lint-staged": "15.2.2",
    "semantic-release": "23.1.1",
    "simple-git-hooks": "2.13.1",
    "tsm": "2.3.0",
    "typescript": "5.4.5",
    "typescript-eslint": "7.8.0",
    "uvu": "0.5.6"
  }
}
